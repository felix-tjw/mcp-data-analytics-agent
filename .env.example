# Copy to .env. Never commit real secrets.
OPENROUTER_API_KEY=
# Alternative OpenAI-compatible provider:
OPENAI_API_KEY=
MODEL=
# Optional; defaults to OpenRouter when OPENROUTER_API_KEY is populated.
LLM_BASE_URL=

# Leave URL blank to disable remote web search.
# Tavily example: https://mcp.tavily.com/mcp/
WEB_SEARCH_MCP_URL=
WEB_SEARCH_TRANSPORT=http
WEB_SEARCH_AUTH_MODE= # keyless or api_key

TAVILY_API_KEY=
WEB_SEARCH_API_KEY=
WEB_SEARCH_AUTH_HEADER=Authorization
WEB_SEARCH_AUTH_PREFIX="Bearer "

AGGREGATOR_HOST=127.0.0.1
AGGREGATOR_PORT=8000
AGGREGATOR_URL=http://127.0.0.1:8000/mcp
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Blank uses a random per-process key; restarting signs out browser sessions.
SECRET_KEY=
COOKIE_SECURE=false

# Lightweight lexical retrieval works without a model download.
# For semantic RAG: install requirements-rag.txt and set sentence-transformers.
RAG_BACKEND=tfidf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=./vector_store
# Optional local Python entrypoint implementing the documented RAG tool contract.
RAG_SERVER_SCRIPT=
UPLOAD_FOLDER=./uploads
MAX_UPLOAD_MB=20
TOOL_TIMEOUT=90
CHAT_TIMEOUT=180
